{
  "name": "@cad/foto",
  "version": "0.1.0",
  "description": "Digitalizar molde por foto: quadro de calibracao, homografia, contorno. TypeScript puro.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "regioes": "tsx scripts/pintar-regioes.mjs"
  },
  "dependencies": {
    "@cad/motor": "0.1.0",
    "clipper2-ts": "^2.0.1-18",
    "fit-curve": "^0.2.0",
    "ml-matrix": "^6.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jimp": "^1.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
