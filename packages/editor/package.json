{
  "name": "@cad/editor",
  "version": "0.1.0",
  "description": "Comportamento do editor de moldes: sessao, camera, snap, selecao e ferramentas. TypeScript puro, sem DOM e sem PixiJS.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cad/motor": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
