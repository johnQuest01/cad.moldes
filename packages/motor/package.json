{
  "name": "@cad/motor",
  "version": "0.1.0",
  "description": "Motor geometrico do CAD de moldes. TypeScript puro: sem DOM, sem render.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-18",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.7.0",
    "verb-nurbs": "^3.0.3",
    "vitest": "^4.1.11"
  }
}
